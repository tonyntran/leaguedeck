# Absolute path below is for the Docker deployment (matches the /app/data volume
# mount in docker-compose.yml). For local, non-Docker development use a relative
# path instead, e.g. sqlite:///./data/leaguedeck.db
DATABASE_URL=sqlite:////app/data/leaguedeck.db
APP_PASSWORD_HASH=
SECRET_KEY=
FERNET_KEY=
ENABLE_SCHEDULER=true
